---
import { Image } from 'astro:assets';
import type { PostSummary } from '@/utils/content';
import { formatDate } from '@/utils/content';
interface Props { post: PostSummary; variant?: 'standard' | 'featured' | 'compact'; }
const { post, variant = 'standard' } = Astro.props;
---
<article class:list={['card', variant]}><a class="image-link" href={post.url} aria-hidden="true" tabindex="-1"><Image src={post.cover.image} alt="" widths={[480, 720]} sizes="(max-width: 700px) 100vw, 33vw" loading={variant === 'featured' ? 'eager' : 'lazy'} fetchpriority={variant === 'featured' ? 'high' : 'auto'} inferSize /></a><div class="card-body"><div class="meta"><a href={post.category.url}>{post.category.name}</a><span>·</span><time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt)}</time><span>·</span><span>{post.readingTime} min read</span></div><h2><a href={post.url}>{post.title}</a></h2><p>{post.description}</p></div></article>
<style>.card { overflow:hidden; border:1px solid var(--line); border-radius:1rem; background:var(--surface); }.image-link { display:block; background:var(--surface-raised); }.image-link :global(img) { width:100%; aspect-ratio:16/9; object-fit:cover; transition:transform .2s ease; }.card:hover .image-link :global(img) { transform:scale(1.025); }.card-body { padding:1.15rem; }.meta { display:flex; flex-wrap:wrap; gap:.4rem; color:var(--muted); font-size:.76rem; }.meta a { color:var(--accent); font-weight:800; text-decoration:none; text-transform:capitalize; }.card h2 { margin:.65rem 0; font:800 clamp(1.15rem,2vw,1.4rem)/1.22 var(--font-display); }.card h2 a { text-decoration:none; }.card p { margin:0; color:var(--muted); font-size:.92rem; }.featured h2 { font-size:clamp(1.5rem,3vw,2.25rem); }.compact .card-body { padding:.9rem; }.compact p { display:none; }</style>
