---
interface Props {
  id: string;
  placeholder?: string;
  label?: string;
}
const { id, placeholder = 'Search guides, networks, and security topics', label = 'Search NodeHunt' } = Astro.props;
const inputId = `${id}-search-input`;
const resultsId = `${id}-search-results`;
const statusId = `${id}-search-status`;
---
<div class="search-box" data-search-box={id}>
  <label class="sr-only" for={inputId}>{label}</label>
  <input id={inputId} type="search" placeholder={placeholder} autocomplete="off" aria-controls={resultsId} />
  <p id={statusId} class="search-status" role="status" aria-live="polite"></p>
  <div id={resultsId} class="search-results"></div>
</div>
<style>
  .search-box { display: grid; gap: .35rem; width: 100%; }
  .search-box input { width: 100%; padding: .75rem 1rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--surface); color: var(--text); font-size: .95rem; }
  .search-box input:focus { outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent); outline-offset: 0; border-color: transparent; }
  .search-status { min-height: 1.1rem; margin: 0; color: var(--muted); font-size: .8rem; }
  .search-status:empty { display: none; }
  .search-results { display: grid; gap: .4rem; max-height: 22rem; overflow: auto; }
  .search-results:empty { display: none; }
  .result { display: grid; gap: .15rem; padding: .7rem .8rem; border-radius: .55rem; background: var(--surface-raised); text-decoration: none; }
  .result:hover { outline: 1px solid var(--line); }
  .result strong { color: var(--text); font-size: .92rem; }
  .result span { color: var(--muted); font-size: .82rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .search-empty { margin: 0; padding: .6rem .2rem; color: var(--muted); font-size: .9rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
</style>
