---
import { Image } from 'astro:assets';
import type { AuthorSummary } from '@/utils/content';
interface Props { author: AuthorSummary; }
const { author } = Astro.props;
---
<a class="author-bline" href={author.url} aria-label={`Written by ${author.name}`}>{author.avatar && <Image src={author.avatar} alt="" class="author-avatar" widths={[64]} />}<span class="author-meta"><span class="author-name">{author.name}</span>{author.role && <span class="author-role">{author.role}</span>}</span></a>
<style>
  .author-bline { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; }
  .author-avatar { width: 2.4rem; height: 2.4rem; border-radius: 50%; object-fit: cover; }
  .author-meta { display: grid; line-height: 1.25; }
  .author-name { font-weight: 800; font-size: .95rem; }
  .author-role { color: var(--muted); font-size: .78rem; }
</style>
