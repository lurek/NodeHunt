---
import { adsConfig } from '@/config/ads';

const cfg = adsConfig.slots.stickyBottom;
const active = adsConfig.enabled && cfg.enabled;
const codes = adsConfig.codes;
if (!active) return;
---

<div class="ad-slot ad-sticky" data-ad-slot="stickyBottom" data-ad-mode="sticky">
  <template data-ad-size="native" set:html={codes.nativeBanner}></template>
  <template data-ad-size="468x90" set:html={codes.banner468x90}></template>
  <template data-ad-size="320x50" set:html={codes.banner320x50}></template>
  <button class="ad-close" type="button" aria-label="Close advertisement">&times;</button>
  <div class="ad-code"></div>
  <span class="ad-label">Advertisement</span>
</div>
