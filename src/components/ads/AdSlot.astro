---
import { adsConfig, type AdSlot } from '@/config/ads';

interface Props {
  slot: AdSlot;
  label?: boolean;
  sticky?: boolean;
}

const { slot, label = true, sticky = false } = Astro.props;
const cfg = adsConfig.slots[slot];
const active = adsConfig.enabled && cfg.enabled && Boolean(adsConfig.provider);

if (!active) return;

const dims = `min-height:${cfg.minHeight}px;max-width:${cfg.maxWidth}px`;
---

<div class="ad {sticky ? 'ad-sticky' : ''}" style={dims} data-ad-slot={slot}>
  {label && <span class="ad-label">Advertisement</span>}
  {sticky && <button class="ad-close" type="button" aria-label="Close advertisement">&times;</button>}
  <slot />
</div>

<script>
  const close = document.querySelector<HTMLButtonElement>('.ad-sticky .ad-close');
  const sticky = document.querySelector<HTMLElement>('.ad-sticky');
  close?.addEventListener('click', () => sticky?.remove());
</script>

<style>
  .ad { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; width:100%; margin-inline:auto; }
  .ad-label { font-size:.65rem; line-height:1; text-transform:uppercase; letter-spacing:.12em; color:var(--muted); }
  .ad-sticky { position:fixed; inset-inline:0; bottom:0; z-index:50; padding:0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); background:var(--surface); border-top:1px solid var(--line); box-shadow:0 -1rem 2rem #0001; }
  .ad-close { position:absolute; top:.35rem; right:.5rem; border:0; background:transparent; color:var(--muted); font-size:1.1rem; cursor:pointer; padding:.25rem; }
</style>
