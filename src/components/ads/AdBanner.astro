---
import { adsConfig, type AdSlotKey } from '@/config/ads';

interface Props {
  slot: AdSlotKey;
}

const { slot } = Astro.props;
const cfg = adsConfig?.slots?.[slot];
if (!adsConfig?.enabled || !cfg?.enabled) return;
const codes = adsConfig?.codes ?? ({} as Record<string, string>);
---

<div
  class="ad-slot"
  data-ad-slot={slot}
  data-pagefind-ignore
  data-ad-mode="banner"
>
  <template data-ad-size="728x90" set:html={codes.banner728x90}></template>
  <template data-ad-size="320x50" set:html={codes.banner320x50}></template>
  <div class="ad-code"></div>
  <span class="ad-label">Advertisement</span>
</div>
