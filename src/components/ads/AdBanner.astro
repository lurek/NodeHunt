---
import { adsConfig, type AdSlotKey, WIDE_BREAKPOINT } from '@/config/ads';

interface Props {
  slot: AdSlotKey;
}

const { slot } = Astro.props;
const cfg = adsConfig.slots[slot];
const active = adsConfig.enabled && cfg.enabled;
const codes = adsConfig.codes;
if (!active) return;

const minWidth = slot === 'topBanner' ? WIDE_BREAKPOINT : 0;
---

<div class="ad-slot" data-ad-slot={slot} data-ad-mode="banner" data-ad-min-width={minWidth}>
  <template data-ad-size="728x90" set:html={codes.banner728x90}></template>
  <template data-ad-size="468x90" set:html={codes.banner468x90}></template>
  <template data-ad-size="320x50" set:html={codes.banner320x50}></template>
  <div class="ad-code"></div>
  <span class="ad-label">Advertisement</span>
</div>
