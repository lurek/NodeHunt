---
import { adsConfig } from '@/config/ads';

const cfg = adsConfig?.slots?.topBanner;
if (!adsConfig?.enabled || !cfg?.enabled) return;

const nativeCode = adsConfig?.codes?.nativeBanner?.trim() || '';
const isDefaultAdsterra = !nativeCode || nativeCode.includes('9c82eaf8854b4384e45bf9884eb8e4f8');
---

<aside class="top-banner-ad" aria-label="Advertisement" data-pagefind-ignore>
  <div class="container top-banner-container">
    <div class="top-banner-card">
      <div class="top-banner-meta">
        <span class="top-banner-badge">
          <span class="top-banner-dot" aria-hidden="true"></span>
          <span>Sponsored</span>
        </span>
        <span class="top-banner-label">Advertisement</span>
      </div>
      <div class="top-banner-slot">
        {isDefaultAdsterra ? (
          <div id="container-9c82eaf8854b4384e45bf9884eb8e4f8" class="top-banner-native"></div>
          <script
            is:inline
            async="async"
            data-cfasync="false"
            src="https://wistfulseverely.com/9c82eaf8854b4384e45bf9884eb8e4f8/invoke.js"
          ></script>
        ) : (
          <div class="top-banner-custom" set:html={nativeCode} />
        )}
      </div>
    </div>
  </div>
</aside>

<style>
  .top-banner-ad {
    width: 100%;
    margin-block: 1.25rem 1.75rem;
  }

  .top-banner-container {
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
  }

  .top-banner-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: 0.85rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 95%, transparent);
    padding: 0.65rem 1rem 0.85rem;
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.35);
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
  }

  :global(:root[data-theme='light']) .top-banner-card {
    background: var(--surface);
    box-shadow: 0 2px 10px -2px rgba(16, 24, 39, 0.06), 0 1px 3px -1px rgba(16, 24, 39, 0.04);
  }

  .top-banner-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .top-banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  .top-banner-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .top-banner-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .top-banner-slot {
    width: 100%;
    min-height: 90px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .top-banner-native,
  :global(#container-9c82eaf8854b4384e45bf9884eb8e4f8) {
    width: 100% !important;
    max-width: 100% !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    overflow-x: hidden !important;
  }

  :global(#container-9c82eaf8854b4384e45bf9884eb8e4f8 iframe),
  :global(#container-9c82eaf8854b4384e45bf9884eb8e4f8 img),
  :global(#container-9c82eaf8854b4384e45bf9884eb8e4f8 > div) {
    max-width: 100% !important;
  }

  @media (max-width: 640px) {
    .top-banner-ad {
      margin-block: 0.75rem 1.25rem;
    }

    .top-banner-container {
      width: min(100% - 1.25rem, 76rem);
    }

    .top-banner-card {
      padding: 0.45rem 0.6rem 0.65rem;
      border-radius: 0.75rem;
    }

    .top-banner-slot {
      min-height: 60px;
    }

    .top-banner-meta {
      margin-bottom: 0.35rem;
    }

    .top-banner-badge {
      font-size: 0.6rem;
      padding: 0.15rem 0.4rem;
    }

    .top-banner-label {
      font-size: 0.6rem;
    }
  }
</style>
