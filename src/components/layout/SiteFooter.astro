---
import { siteConfig } from '@/config/site';
---
<footer class="footer"><div class="container footer-grid"><section><a class="brand" href="/">NodeHunt</a><p>{siteConfig.tagline}</p></section><section><h2>Explore</h2><a href="/blog/">All articles</a><a href="/category/web3-nodes/">Web3 Nodes</a><a href="/category/depin/">DePIN</a><a href="/search/">Search</a></section><section><h2>Trust</h2><a href="/about/">About & editorial policy</a><a href="/disclaimer/">Disclaimer</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/rss.xml">RSS</a></section></div><div class="container footer-bottom">© {new Date().getFullYear()} NodeHunt. Educational content, not financial advice.</div></footer>
<style>.footer { margin-top:5rem; border-top:1px solid var(--line); background:var(--surface); }.footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr; gap:2rem; padding:3.5rem 0; }.footer h2 { margin:0 0 .75rem; font:800 .8rem var(--font-display); letter-spacing:.1em; text-transform:uppercase; color:var(--muted); }.footer section { display:grid; align-content:start; gap:.45rem; }.footer p { max-width:32rem; color:var(--muted); }.brand { font:800 1.2rem var(--font-display); text-decoration:none; }.footer a:not(.brand) { color:var(--muted); text-decoration:none; }.footer-bottom { padding:1.25rem 0; border-top:1px solid var(--line); color:var(--muted); font-size:.85rem; }@media(max-width:650px){.footer-grid { grid-template-columns:1fr; }}</style>
