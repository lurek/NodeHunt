---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import InlineArticleAd from '@/components/ads/InlineArticleAd.astro';
import BottomBannerAd from '@/components/ads/BottomBannerAd.astro';
import { getPublishedSummaries } from '@/utils/content';
const posts = await getPublishedSummaries();
const featured = posts.filter((post) => post.featured).slice(0, 1);
const latest = posts.filter((post) => !featured.includes(post)).slice(0, 6);
const trending = [...posts].sort((a, b) => (b.trendingScore ?? 0) - (a.trendingScore ?? 0)).slice(0, 3);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'NodeHunt', url: Astro.site?.toString(), description: 'Research-led Web3 infrastructure guides and analysis.' };
---
<BaseLayout description="Research-led guides and analysis for Web3 nodes, DePIN, crypto infrastructure, wallet security, and AI x blockchain." {jsonLd}>
  <section class="hero container"><p class="eyebrow">Research-led Web3 intelligence</p><h1>Infrastructure moves fast.<br /><em>Understand it first.</em></h1><p>NodeHunt explains nodes, DePIN, wallet safety, and AI x blockchain with practical context—not empty promises.</p><form action="/search/" role="search"><label class="sr-only" for="home-search">Search NodeHunt</label><input id="home-search" name="q" type="search" placeholder="Search guides, networks, and security topics" /><button>Search</button></form></section>
  {featured[0] && <section class="container section"><div class="section-head"><p class="eyebrow">Featured briefing</p><a href="/blog/">Browse all articles →</a></div><ArticleCard post={featured[0]} variant="featured" /></section>}
  <InlineArticleAd />
  <section class="container section"><div class="section-head"><div><p class="eyebrow">Recent updates</p><h2>Signal, without the noise.</h2></div></div><div class="grid">{latest.map((post) => <ArticleCard {post} />)}</div></section>
  <section class="container split section"><div><p class="eyebrow">Trending research</p><h2>Start with the fundamentals.</h2><p class="muted">Clear operating models, security trade-offs, and direct paths to primary sources.</p></div><ol>{trending.map((post, index) => <li><span>0{index + 1}</span><a href={post.url}>{post.title}</a></li>)}</ol></section>
  <section class="container newsletter surface"><p class="eyebrow">Newsletter · Coming soon</p><h2>One thoughtful infrastructure read at a time.</h2><p>Newsletter delivery is not enabled yet. Follow the research archive or use RSS in the meantime.</p><a href="/rss.xml">Subscribe by RSS →</a></section>
  <BottomBannerAd />
</BaseLayout>
<style>.hero { padding:clamp(4rem,10vw,8rem) 0 3rem; text-align:center; }.hero h1 { margin:.4rem auto 1rem; max-width:850px; font:800 clamp(2.7rem,7vw,6rem)/.98 var(--font-display); letter-spacing:-.06em; }.hero em { color:var(--accent); font-style:normal; }.hero > p:not(.eyebrow) { max-width:42rem; margin:0 auto 1.7rem; color:var(--muted); font-size:1.1rem; }.hero form { display:flex; max-width:39rem; margin:auto; padding:.35rem; border:1px solid var(--line); border-radius:.85rem; background:var(--surface); }.hero input { min-width:0; flex:1; border:0; outline:0; background:transparent; color:var(--text); padding:.6rem .8rem; }.hero button,.newsletter a { border:0; border-radius:.6rem; background:var(--accent); color:#062219; padding:.65rem 1rem; font-weight:800; text-decoration:none; }.section { margin-top:4rem; }.section-head { display:flex; align-items:end; justify-content:space-between; gap:1rem; margin-bottom:1.2rem; }.section-head h2,.split h2,.newsletter h2 { margin:.2rem 0; font:800 clamp(1.8rem,4vw,2.8rem)/1.1 var(--font-display); }.section-head a { color:var(--accent); }.grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }.split { display:grid; grid-template-columns:1fr 1.3fr; gap:3rem; align-items:start; }.muted,.newsletter p { color:var(--muted); }.split ol { display:grid; gap:.75rem; margin:0; padding:0; list-style:none; }.split li { display:grid; grid-template-columns:3rem 1fr; gap:1rem; align-items:center; padding:1rem 0; border-bottom:1px solid var(--line); }.split li span { color:var(--accent); font:800 1.1rem var(--font-display); }.split li a { font:800 1.05rem/1.3 var(--font-display); text-decoration:none; }.newsletter { margin-top:4rem; padding:clamp(1.5rem,4vw,3rem); }.newsletter a { display:inline-block; margin-top:.5rem; } .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); } @media(max-width:780px){.grid{grid-template-columns:1fr 1fr}.split{grid-template-columns:1fr}}@media(max-width:520px){.grid{grid-template-columns:1fr}}</style>
