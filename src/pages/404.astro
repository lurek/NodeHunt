---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex><section class="container missing"><p class="eyebrow">404</p><h1>This route went off-grid.</h1><p>The page may have moved, been retired, or never existed.</p><a href="/">Return to NodeHunt →</a></section></BaseLayout><style>.missing{padding:8rem 0;text-align:center}.missing h1{font:800 clamp(2.5rem,7vw,5rem)/1 var(--font-display)}.missing p{color:var(--muted)}.missing a{display:inline-block;margin-top:1rem;padding:.7rem 1rem;border-radius:.6rem;background:var(--accent);color:#062219;font-weight:800;text-decoration:none}</style>
