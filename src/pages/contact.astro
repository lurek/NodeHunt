---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPageDocument } from '@/utils/content';

const page = await getPageDocument('contact');
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="container page">
    <header>
      <p class="eyebrow">{page.data.title}</p>
      <h1>{page.data.title}</h1>
      <p class="lead">{page.data.description}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
<style>.page{max-width:48rem;padding:4rem 0}.page h1{font:800 clamp(2.5rem,6vw,4.5rem)/1 var(--font-display)}.lead{color:var(--muted);font-size:1.25rem}.page p{color:var(--muted)}.page a{color:var(--accent)}</style>
