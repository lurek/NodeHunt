---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchBox from '@/components/search/SearchBox.astro';
---
<BaseLayout title="Search" noindex><section class="container search"><p class="eyebrow">Find your next guide</p><h1>Search NodeHunt</h1><SearchBox id="page" /></section></BaseLayout>
<style>.search{max-width:52rem;padding:4rem 0}.search h1{margin:.3rem 0 2rem;font:800 clamp(2.5rem,6vw,4rem)/1 var(--font-display)}.search :global(.search-box input){padding:1rem 1.15rem;font-size:1.05rem;border-radius:.75rem}.search :global(.search-box){gap:.5rem}.search :global(.search-results){max-height:none}</style>
